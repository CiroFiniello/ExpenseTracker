@model ExpenseTracker.ViewModels.CreateExpenseViewModel

@{
    ViewData["Title"] = "Nuova spesa";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">

        <!-- Page header -->
        <div class="mb-4">
            <a asp-action="Index"
               class="text-decoration-none text-muted small">
                ← Torna alle spese
            </a>

            <h1 class="fw-bold mt-3 mb-2">
                Registra una spesa
            </h1>

            <p class="text-muted mb-0">
                Inserisci le informazioni del nuovo movimento.
            </p>
        </div>

        <div class="row g-4">

            <!-- Main form -->
            <div class="col-12 col-lg-8">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">

                        <form asp-action="Create"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>

                            <h2 class="h5 fw-bold mb-1">
                                Informazioni generali
                            </h2>

                            <p class="text-muted small mb-4">
                                Dove e quando hai effettuato la spesa?
                            </p>

                            <!-- Description -->
                            <div class="mb-3">
                                <label asp-for="Description"
                                       class="form-label fw-semibold">
                                    Descrizione
                                </label>

                                <input asp-for="Description"
                                       class="form-control"
                                       placeholder="Es. Spesa settimanale" />

                                <span asp-validation-for="Description"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="row g-3">

                                <!-- Merchant -->
                                <div class="col-md-6">
                                    <label asp-for="Merchant"
                                           class="form-label fw-semibold">
                                        Esercente
                                    </label>

                                    <input asp-for="Merchant"
                                           class="form-control"
                                           placeholder="Es. Lidl" />

                                    <span asp-validation-for="Merchant"
                                          class="text-danger small">
                                    </span>
                                </div>

                                <!-- Date -->
                                <div class="col-md-6">
                                    <label asp-for="OccurredOn"
                                           class="form-label fw-semibold">
                                        Data
                                    </label>

                                    <input asp-for="OccurredOn"
                                           type="date"
                                           class="form-control" />

                                    <span asp-validation-for="OccurredOn"
                                          class="text-danger small">
                                    </span>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <h2 class="h5 fw-bold mb-1">
                                Ripartizione della spesa
                            </h2>

                            <p class="text-muted small mb-4">
                                Per ora inseriamo una sola categoria
                                e il relativo importo.
                            </p>

                            <div class="row g-3">

                                <!-- Category -->
                                <div class="col-md-6">
                                    <label asp-for="CategoryId"
                                           class="form-label fw-semibold">
                                        Categoria
                                    </label>

                                    <select asp-for="CategoryId"
                                            class="form-select">
                                        <option value="">
                                            Seleziona categoria
                                        </option>
                                    </select>

                                    <span asp-validation-for="CategoryId"
                                          class="text-danger small">
                                    </span>
                                </div>

                                <!-- Amount -->
                                <div class="col-md-6">
                                    <label asp-for="Amount"
                                           class="form-label fw-semibold">
                                        Importo (€)
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            €
                                        </span>

                                        <input asp-for="Amount"
                                               type="number"
                                               step="0.01"
                                               min="0.01"
                                               class="form-control"
                                               placeholder="0.00" />
                                    </div>

                                    <span asp-validation-for="Amount"
                                          class="text-danger small">
                                    </span>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <!-- Form actions -->
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Index"
                                   class="btn btn-outline-secondary">
                                    Annulla
                                </a>

                                <button type="submit"
                                        class="btn btn-primary"
                                        disabled
                                        title="Attiveremo il salvataggio dopo aver collegato categoria e POST">
                                    Salva spesa
                                </button>
                            </div>
                        </form>

                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">

                        <h2 class="h6 fw-bold">
                            Come funziona?
                        </h2>

                        <p class="text-muted small">
                            Ogni spesa rappresenta un acquisto
                            o un'uscita economica.
                        </p>

                        <p class="text-muted small">
                            La categoria indica a quale gruppo
                            appartiene l'importo registrato.
                        </p>

                        <div class="alert alert-primary small mb-0">
                            Successivamente potremo suddividere
                            una spesa tra più categorie.
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
