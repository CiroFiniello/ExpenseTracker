@model ExpenseTracker.ViewModels.EditExpenseViewModel

@{
    ViewData["Title"] = "Modifica spesa";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">

        <div class="mb-4">
            <a asp-action="Index"
               class="text-decoration-none text-muted small">
                ← Torna alle spese
            </a>

            <h1 class="fw-bold mt-3 mb-2">Modifica spesa</h1>
            <p class="text-muted mb-0">
                Aggiorna il movimento e le sue ripartizioni.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">

                        <form asp-action="Edit"
                              asp-route-id="@Model.Id"
                              method="post">

                            <input type="hidden" asp-for="Id" />

                            <div asp-validation-summary="All"
                                 class="text-danger mb-3"></div>

                            <h2 class="h5 fw-bold mb-1">
                                Informazioni generali
                            </h2>

                            <p class="text-muted small mb-4">
                                Modifica i dati della spesa.
                            </p>

                            <div class="mb-3">
                                <label asp-for="Description"
                                       class="form-label fw-semibold">
                                    Descrizione
                                </label>

                                <input asp-for="Description"
                                       class="form-control" />

                                <span asp-validation-for="Description"
                                      class="text-danger small"></span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Merchant"
                                           class="form-label fw-semibold">
                                        Esercente
                                    </label>

                                    <input asp-for="Merchant"
                                           class="form-control" />

                                    <span asp-validation-for="Merchant"
                                          class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="OccurredOn"
                                           class="form-label fw-semibold">
                                        Data
                                    </label>

                                    <input asp-for="OccurredOn"
                                           type="date"
                                           class="form-control" />

                                    <span asp-validation-for="OccurredOn"
                                          class="text-danger small"></span>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <h2 class="h5 fw-bold mb-1">
                                Ripartizione della spesa
                            </h2>

                            <p class="text-muted small mb-4">
                                Modifica gli importi, aggiungi categorie
                                o rimuovi quelle non necessarie.
                            </p>

                            <div id="allocation-rows">
                                @for (var i = 0; i < Model.Allocations.Count; i++)
                                {
                                    <div class="allocation-row row g-3 align-items-end mb-3">

                                        <input asp-for="Allocations[i].Id"
                                               type="hidden"
                                               data-field="Id" />

                                        <div class="col-md-5">
                                            <label asp-for="Allocations[i].CategoryId"
                                                   data-label="CategoryId"
                                                   class="form-label fw-semibold">
                                                Categoria
                                            </label>

                                            <select asp-for="Allocations[i].CategoryId"
                                                    asp-items="Model.Categories"
                                                    data-field="CategoryId"
                                                    class="form-select"
                                                    required>
                                                <option value="">Seleziona categoria</option>
                                            </select>

                                            <span asp-validation-for="Allocations[i].CategoryId"
                                                  data-error="CategoryId"
                                                  class="text-danger small"></span>
                                        </div>

                                        <div class="col-md-4">
                                            <label asp-for="Allocations[i].Amount"
                                                   data-label="Amount"
                                                   class="form-label fw-semibold">
                                                Importo (€)
                                            </label>

                                            <div class="input-group">
                                                <span class="input-group-text">€</span>

                                                <input asp-for="Allocations[i].Amount"
                                                       data-field="Amount"
                                                       type="number"
                                                       min="0.01"
                                                       step="0.01"
                                                       required
                                                       class="form-control" />
                                            </div>

                                            <span asp-validation-for="Allocations[i].Amount"
                                                  data-error="Amount"
                                                  class="text-danger small"></span>
                                        </div>

                                        <div class="col-md-3">
                                            <button type="button"
                                                    class="btn btn-outline-danger remove-allocation w-100">
                                                Rimuovi
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>

                            <button type="button"
                                    id="add-allocation"
                                    class="btn btn-outline-primary btn-sm mt-2">
                                + Aggiungi categoria
                            </button>

                            <div class="d-flex justify-content-between
                                align-items-center border-top mt-4 pt-3">
                                <span class="fw-semibold">Totale spesa</span>

                                <strong id="expense-total" class="fs-4">
                                    0,00 €
                                </strong>
                            </div>

                            <hr class="my-4" />

                            <div class="d-flex flex-wrap justify-content-between gap-2">
                                <a asp-action="Delete"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-outline-danger">
                                    Elimina spesa
                                </a>

                                <div class="d-flex gap-2">
                                    <a asp-action="Index"
                                       class="btn btn-outline-secondary">
                                        Annulla
                                    </a>

                                    <button type="submit"
                                            class="btn btn-primary">
                                        Salva modifiche
                                    </button>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">

                        <h2 class="h6 fw-bold">
                            Modifica delle ripartizioni
                        </h2>

                        <p class="text-muted small">
                            Puoi modificare gli importi e associare
                            più categorie alla stessa spesa.
                        </p>

                        <div class="alert alert-primary small mb-0">
                            Il totale viene ricalcolato automaticamente
                            quando modifichi le ripartizioni.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<template id="allocation-template">
    <div class="allocation-row row g-3 align-items-end mb-3">

        <input type="hidden" data-field="Id" value="0" />

        <div class="col-md-5">
            <label data-label="CategoryId"
                   class="form-label fw-semibold">
                Categoria
            </label>

            <select data-field="CategoryId"
                    class="form-select"
                    required>
                <option value="">Seleziona categoria</option>

                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Value">
                        @category.Text
                    </option>
                }
            </select>

            <span data-error="CategoryId" class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label data-label="Amount"
                   class="form-label fw-semibold">
                Importo (€)
            </label>

            <div class="input-group">
                <span class="input-group-text">€</span>

                <input data-field="Amount"
                       type="number"
                       min="0.01"
                       step="0.01"
                       required
                       class="form-control" />
            </div>

            <span data-error="Amount" class="text-danger small"></span>
        </div>

        <div class="col-md-3">
            <button type="button"
                    class="btn btn-outline-danger remove-allocation w-100">
                Rimuovi
            </button>
        </div>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const container = document.getElementById("allocation-rows");
        const template = document.getElementById("allocation-template");
        const addButton = document.getElementById("add-allocation");
        const totalElement = document.getElementById("expense-total");

        function refreshAllocations() {
            const rows = Array.from(
                container.querySelectorAll(".allocation-row")
            );

            rows.forEach((row, index) => {
                for (const field of ["Id", "CategoryId", "Amount"]) {
                    const input = row.querySelector(
                        `[data-field="${field}"]`
                    );

                    input.name = `Allocations[${index}].${field}`;
                    input.id = `Allocations_${index}__${field}`;

                    const label = row.querySelector(
                        `[data-label="${field}"]`
                    );

                    if (label) {
                        label.htmlFor = input.id;
                    }

                    const error = row.querySelector(
                        `[data-error="${field}"]`
                    );

                    if (error) {
                        error.setAttribute(
                            "data-valmsg-for",
                            input.name
                        );
                    }
                }

                row.querySelector(".remove-allocation").disabled =
                    rows.length === 1;
            });

            updateTotal();
        }

        function updateTotal() {
            const amounts = container.querySelectorAll(
                '[data-field="Amount"]'
            );

            const total = Array.from(amounts).reduce(
                (sum, input) => sum + (Number(input.value) || 0),
                0
            );

            totalElement.textContent = total.toLocaleString(
                "it-IT",
                {
                    style: "currency",
                    currency: "EUR"
                }
            );
        }

        addButton.addEventListener("click", () => {
            const newRow = template.content
                .firstElementChild.cloneNode(true);

            container.appendChild(newRow);
            refreshAllocations();
        });

        container.addEventListener("click", event => {
            const button = event.target.closest(".remove-allocation");

            if (!button) return;

            const rows = container.querySelectorAll(".allocation-row");

            if (rows.length <= 1) return;

            button.closest(".allocation-row").remove();
            refreshAllocations();
        });

        container.addEventListener("input", updateTotal);

        refreshAllocations();
    </script>
}
